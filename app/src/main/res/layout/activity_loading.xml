<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <View
        android:id="@+id/view_pulse_outer"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_circle_faint"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon_center"
        app:layout_constraintEnd_toEndOf="@+id/iv_icon_center"
        app:layout_constraintStart_toStartOf="@+id/iv_icon_center"
        app:layout_constraintTop_toTopOf="@+id/iv_icon_center" />

    <View
        android:id="@+id/view_pulse_inner"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_circle_light"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon_center"
        app:layout_constraintEnd_toEndOf="@+id/iv_icon_center"
        app:layout_constraintStart_toStartOf="@+id/iv_icon_center"
        app:layout_constraintTop_toTopOf="@+id/iv_icon_center" />

    <ImageView
        android:id="@+id/iv_icon_center"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="100dp"
        android:src="@android:drawable/ic_dialog_map"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/brand_main" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/brand_main"
        app:indicatorSize="120dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon_center"
        app:layout_constraintEnd_toEndOf="@+id/iv_icon_center"
        app:layout_constraintStart_toStartOf="@+id/iv_icon_center"
        app:layout_constraintTop_toTopOf="@+id/iv_icon_center"
        app:trackColor="#E2E8F0"
        app:trackThickness="4dp" />

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="Locating nearby spots..."
        android:textColor="@color/text_header"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon_center" />

    <TextView
        android:id="@+id/tv_tip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Hold tight! We are scanning the nearest available parking zones."
        android:textColor="@color/text_body"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_message" />


</androidx.constraintlayout.widget.ConstraintLayout>